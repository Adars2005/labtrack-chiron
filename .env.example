# LabTrack runs in self-contained demo mode by default.
# No credentials are required: notifications are captured in the in-app outbox.

# Real delivery requires BOTH NOTIFY_MODE=live and a Resend API key.
# Marking a case ready always POSTs to /api/notify automatically.
NOTIFY_MODE=test
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=LabTrack <onboarding@resend.dev>

# IANA timezone used for the lab-side view of every deadline.
LAB_TIMEZONE=Asia/Kolkata
